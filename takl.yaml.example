cluster:
  node_id: "node-1"
  bind: 7946
  profile: "lan"
  join: []
  peers: []
  gossip_key: ""

network:
  http_addr: "0.0.0.0:8090"
  sync_addr: "0.0.0.0:8100"
  advertise_addr: ""
  sync_tls:
    ca_file: ""
    cert_file: ""
    key_file: ""

storage:
  db_path: "takl.db"

execution:
  backend: "docker"
  capacity: 4
  region: "us-east-1"

agent:
  tick: 1s
  sync_interval: 2s
